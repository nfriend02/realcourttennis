# Public Firebase web config (bundled into the client; restrict via Firebase Console).
# Copy to .env.local and fill in. Leave empty to use MockBackend (offline).
# Firebase Console > Project settings > General > Your apps > Web app config.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
# Named Firestore DB id (Seoul asia-northeast3). Use project id if not "(default)".
VITE_FIRESTORE_DATABASE_ID=
VITE_FIREBASE_REGION=asia-northeast3
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_PHONE_ALIAS_DOMAIN=realcourttennis.app
