# Public Firebase web config (bundled into the client; not secret). Copy to .env.local and fill in.
# Leave empty to run with the local MockBackend (offline accounts, local ranking).
# Firebase Console > Project settings > General > Your apps > Web app config.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_PHONE_ALIAS_DOMAIN=phone.realcourttennis.test
